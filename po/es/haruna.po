msgctxt "@label:spinbox"
msgid "Fallback (dB)"
msgstr "Alternativa (dB)"

#: src/Settings/AudioPage.qml:251
msgctxt "@info:tooltip"
msgid ""
"Gain in dB to apply if the file has no replay gain tags.<br><br>This setting "
"is in effect only when:<br>- the replaygain setting is disabled<br>- the "
"replaygain setting is enabled and the file has no replaygain metadata<br>If "
"this is in effect, other replaygain settings are ignored."
msgstr ""
"Ganancia en dB que se aplica si el archivo no tiene etiquetas de ganancia de "
"reproducción.<br><br>Este ajuste solo entra en efecto cuando:<br>- el ajuste "
"de ganancia de reproducción está desactivado<br>- el ajuste de ganancia de "
"reproducción está activado y el archivo no tiene metadatos de ganancia de "
"reproducción<br>Si esto está en vigor, se ignoran los demás ajustes de "
"ganancia de reproducción."

